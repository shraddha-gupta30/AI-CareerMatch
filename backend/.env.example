# Backend Environment Configuration
APP_ENV=development
DEBUG=true
PORT=8000

# Security
SECRET_KEY=development_only_secret_key_minimum_32_characters_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (Phase 2+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_careermatch_db

# Google Gemini API Key (Backend only - Phase 4+)
GEMINI_API_KEY=your_gemini_api_key_here

# Local File Storage (resolved via pathlib.Path relative to project root)
UPLOAD_DIR=uploads/resumes
