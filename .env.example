# ==============================================================================
# AI CareerMatch — Environment Configuration Template
# Copy this file to backend/.env and frontend/.env respectively.
# ==============================================================================

# Backend Configuration
APP_ENV=development
DEBUG=true
PORT=8000

# Security (Required for JWT in Phase 3+)
SECRET_KEY=change_this_to_a_secure_random_string_minimum_32_characters_long

# Database (Required in Phase 2+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_careermatch_db

# AI Integration (Backend only - Required in Phase 4+)
# Never expose this key to the frontend or browser!
GEMINI_API_KEY=your_gemini_api_key_here

# Local Storage Directory (Relative to project root, managed via pathlib.Path)
UPLOAD_DIR=uploads/resumes

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
